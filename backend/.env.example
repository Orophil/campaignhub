# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campaignhub
# Secret used to sign JWT access tokens - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (any value accepted by jsonwebtoken, e.g. 15m, 8h, 1d)
JWT_EXPIRES_IN=8h
# HTTP port for the API
PORT=4000
# Comma-separated list of allowed browser origins (the Next.js app)
CORS_ORIGIN=http://localhost:3000
# Set to "false" to disable the every-minute publisher job (e.g. on extra API replicas)
PUBLISHER_ENABLED=true
